# --- middleware ---
MIDDLEWARE_PORT=4100
LOG_LEVEL=info

# --- upstream LiteLLM ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-REPLACE_ME              # must match gateway LITELLM_MASTER_KEY

# --- request budget (CONTRACT.md §2) ---
REQUEST_TIMEOUT_MS=90000
REQUEST_TIMEOUT_MS_MAX=115000
DEFAULT_MAX_TOKENS=2048
HARD_MAX_TOKENS=8192

# --- paths ---
KEYS_FILE=./.secrets/keys.json
PROFILES_DIR=../profiles
REQUEST_LOG_FILE=./logs/requests.log

# --- logical model names allowed at the edge ---
ALLOWED_MODELS=celeris-local-primary,celeris-local-fast

# --- RAG (unused for Flowgenix; provisional until the RAG report) ---
# RAG_BASE_URL=http://localhost:8000
# RAG_PROJECT_KEY=
