# Repo-root env, read by deploy/docker-compose.yml.
# Copy to .env and fill in. Never commit .env.

# Shared secret between the middleware and LiteLLM.
LITELLM_MASTER_KEY=sk-REPLACE_ME

# Ollama (native on the host). From inside the LiteLLM container use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Logical model -> real Ollama tag. Placeholders until the bake-off picks the winner.
# Confirm exact current tags on ollama.com/library before pulling (PROJECT_LOG.md §4).
LOCAL_PRIMARY_MODEL=llama3.2:3b
LOCAL_FAST_MODEL=llama3.2:3b
