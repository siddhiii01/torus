# Machine-local reader enable flags (see docs/SETUP.md)
config/local.yaml

# --- Python / OCR ---
.venv/
__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.deepeval/

# Generated reports. They contain real file names from customer data.
reports/

# Never commit documents, OCR output, or answer keys.
# Real data lives under TORUS_DATA_DIR (outside the repo). See docs/SETUP.md.
data/**
!data/README.md
samples/
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp
*.zip
*.eml
*.xls
*.xlsx
*.xlsm
*.csv
!requirements.txt
# Allow project plan PDFs in docs/ (written by us, no customer content)
!docs/*.pdf
# Allow Local AI project docs (not customer OCR inputs)
!local-ai/docs/**/*.pdf
!local-ai/docs/**/*.png
!local-ai/docs/**/*.jpg
!local-ai/docs/**/*.jpeg

# --- Local AI (Node / Docker / Ollama stack under local-ai/) ---
# secrets & env
.env
.env.*
!.env.example
**/.secrets/*
!**/.secrets/*.example.json
*.pem
*.key

# node
node_modules/
npm-debug.log*
.eslintcache

# eval / promptfoo
local-ai/eval/promptfoo/results/
.promptfoo/
promptfoo-errors.log

# logs & runtime
**/logs/
*.log
!local-ai/deploy/*.log

# baseline / dump artifacts that may contain real doc content
**/baselines/
**/dumps/
**/fixtures/real/

# Synthetic fixture debug dumps (generators are committed; images are not)
tests/fixtures/synth/generated/
tests/fixtures/synth/fonts/*.ttf
tests/fixtures/synth/fonts/*.otf
!tests/fixtures/synth/fonts/README.md

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
